# Reference for the environment variables read by srv/cosmic-notification-service.js.
# If SMTP_HOST, SMTP_USER and SMTP_PASSWORD are not all set, the service falls back
# to nodemailer's jsonTransport, which builds the email in memory without sending it
# anywhere (this is what happens locally and in the automated tests).
#
# This project does not load .env files automatically (no dotenv wiring is present),
# so export these into your actual shell/process environment before running
# "npm start" if you want to send real emails through an SMTP server.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional: defaults to "Galactic Adventure <noreply@galactic-adventure.example>"
NOTIFICATION_FROM=
